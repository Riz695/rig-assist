# Copy to .env and fill in what you need: cp .env.example .env
# Put comments on their own line above an empty value: Docker Compose would read
# `KEY=   # comment` as KEY="# comment" (Python's dotenv wouldn't).
# Every variable is optional for local development: the defaults run fully offline
# with a fake LLM. Never commit .env (it's gitignored).
# Later phases add their variables here (e.g. Azure Blob Storage in Phase 7).

# --- App ---
APP_ENV=dev                 # dev | test | prod
LOG_LEVEL=INFO              # DEBUG | INFO | WARNING | ERROR

# --- Data ---
DATA_RAW_DIR=data/raw       # PDF manuals to ingest
DATA_INDEX_DIR=data/index   # BM25 index and other generated files
DATA_PARSED_DIR=data/parsed # OCR page cache (each page is OCR'd once)
MODELS_DIR=data/models      # embedding/reranker models, downloaded once (gitignored)
JOB_DB_PATH=data/jobs.sqlite

# --- OCR (olmOCR 2 via any OpenAI-compatible endpoint; costs money when on) ---
OCR_MODE=off                # off | missing (only pages without text) | all (every page)
# required unless OCR_MODE=off, e.g. https://api.parasail.io/v1
OCR_BASE_URL=
# the provider's key (a self-hosted vLLM server may not need one)
OCR_API_KEY=
OCR_MODEL=allenai/olmOCR-2-7B-1025   # model ID; differs between providers
OCR_CONCURRENCY=1           # pages OCR'd at once; ~8 for your own vLLM GPU (docs/ocr-gpu.md)

# --- Retrieval ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
QDRANT_URL=http://localhost:6333   # in docker compose: http://qdrant:6333
# only for Qdrant Cloud
QDRANT_API_KEY=
QDRANT_COLLECTION=rig_assist_chunks

# --- Experiment tracking (make eval; MLflow UI: make mlflow-ui) ---
MLFLOW_TRACKING_URI=sqlite:///data/mlflow/mlflow.db
MLFLOW_ARTIFACT_DIR=data/mlflow/artifacts

# --- LLM ---
LLM_PROVIDER=fake           # fake | openai | azure
# required for openai/azure (for azure: the deployment name)
LLM_MODEL=
# required when LLM_PROVIDER=openai
OPENAI_API_KEY=
# required when LLM_PROVIDER=azure, e.g. https://<name>.openai.azure.com
AZURE_OPENAI_ENDPOINT=
# required when LLM_PROVIDER=azure
AZURE_OPENAI_API_KEY=

# --- Tracing (optional: tracing is off unless both keys are set) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
